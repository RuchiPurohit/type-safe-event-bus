{
  "name": "@ruchi_purohit/type-safe-event-bus",
  "version": "1.0.0",
  "description": "A lightweight, strongly typed event bus for TypeScript applications.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/EventBus.d.ts",
    "dist/src/EventBus.js",
    "dist/src/EventBus.js.map",
    "dist/src/EventBusOptions.d.ts",
    "dist/src/index.d.ts",
    "dist/src/index.js",
    "dist/src/index.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "event-bus",
    "events",
    "typescript",
    "pubsub",
    "type-safe"
  ],
  "author": "Ruchi Purohit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuchiPurohit/type-safe-event-bus.git"
  },
  "bugs": {
    "url": "https://github.com/RuchiPurohit/type-safe-event-bus/issues"
  },
  "homepage": "https://github.com/RuchiPurohit/type-safe-event-bus#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
